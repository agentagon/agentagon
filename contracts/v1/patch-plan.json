{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "editable_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,79}$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "argv"
        ]
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "no_checks_reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      }
    }
  },
  "required": [
    "editable_paths",
    "checks",
    "timeout_seconds",
    "max_attempts"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "checks": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "required": [
          "no_checks_reason"
        ]
      }
    }
  ]
}
