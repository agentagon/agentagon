{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved_user",
        "resolved_verified",
        "dismissed",
        "reopened"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "issue_id",
    "status",
    "reason",
    "evidence"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
