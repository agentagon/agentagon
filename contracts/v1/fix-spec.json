{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentagon frozen evaluation specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "editable_paths",
    "evaluation_paths",
    "benchmark",
    "metrics"
  ],
  "properties": {
    "goal": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "issue_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "editable_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "evaluation_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "benchmark": {
      "$ref": "#/$defs/command"
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "direction",
          "unit"
        ],
        "properties": {
          "direction": {
            "enum": [
              "min",
              "max"
            ]
          },
          "unit": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "task_metrics": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "direction",
          "unit"
        ],
        "properties": {
          "direction": {
            "enum": [
              "min",
              "max"
            ]
          },
          "unit": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "op",
          "bound"
        ],
        "properties": {
          "metric": {
            "$ref": "#/$defs/name"
          },
          "op": {
            "enum": [
              "gte",
              "lte"
            ]
          },
          "bound": {
            "type": "number"
          },
          "reference": {
            "enum": [
              "absolute",
              "baseline_delta",
              "baseline_ratio"
            ],
            "default": "absolute"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv"
        ],
        "properties": {
          "id": {
            "allOf": [
              {
                "$ref": "#/$defs/name"
              },
              {
                "not": {
                  "pattern": "^(?:benchmark$|setup-)"
                }
              }
            ]
          },
          "argv": {
            "$ref": "#/$defs/argv"
          },
          "cwd": {
            "$ref": "#/$defs/path"
          },
          "issue_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "baseline_expected": {
            "enum": [
              "pass",
              "fail"
            ],
            "default": "pass"
          },
          "preflight": {
            "type": "boolean",
            "default": false,
            "description": "Run before the benchmark; stop fix trials on an unexpected exit. Preparation always runs the full sequence."
          }
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "path"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/path"
          },
          "path": {
            "$ref": "#/$defs/executionFile"
          },
          "deliver": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "path"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/path"
          },
          "path": {
            "$ref": "#/$defs/executionFile"
          }
        }
      }
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 3
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "integer"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slots"
      ],
      "properties": {
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "goal"
      ],
      "properties": {
        "goal": {
          "$ref": "#/$defs/text"
        }
      }
    },
    {
      "required": [
        "issue_ids"
      ],
      "properties": {
        "issue_ids": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "not": {
            "pattern": "\u0000"
          }
        }
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,79}$"
    },
    "path": {
      "allOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "not": {
            "pattern": "^/|\\\\|(?:^|/)(?:\\.\\.|\\.git)(?:/|$)"
          }
        }
      ]
    },
    "executionFile": {
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.[aA][gG][eE][nN][tT][aA][gG][oO][nN](?:/|$)|^(?:\\./)*\\.?$"
          }
        }
      ]
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "$ref": "#/$defs/argv"
        },
        "cwd": {
          "$ref": "#/$defs/path"
        }
      }
    }
  }
}
