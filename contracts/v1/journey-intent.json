{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "goal",
    "accepted_by",
    "scoring",
    "discovery",
    "budget"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "accepted_by": {
      "type": "string",
      "minLength": 1
    },
    "scoring": {
      "$ref": "score-definition.json"
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "paths",
        "evidence",
        "creation_authorized"
      ],
      "properties": {
        "status": {
          "enum": [
            "usable",
            "missing",
            "unusable"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "creation_authorized": {
          "type": "boolean"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_trials",
        "max_elapsed_seconds",
        "trial_timeout_seconds"
      ],
      "properties": {
        "max_trials": {
          "type": "integer",
          "minimum": 1
        },
        "max_elapsed_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "trial_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "project",
        "lookback_seconds",
        "max_traces",
        "filters",
        "authorized"
      ],
      "properties": {
        "provider": {
          "enum": [
            "braintrust",
            "langfuse",
            "langsmith",
            "phoenix",
            "otlp"
          ]
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "lookback_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_traces": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "filters": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "authorized": {
          "type": "boolean"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
