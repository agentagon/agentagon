{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 200
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 200
    },
    "host_capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "round_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "branches": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "editable_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "depth_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "hypothesis",
          "author",
          "editable_paths",
          "evidence"
        ]
      }
    },
    "finish_branches": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "branch_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "branch_id",
          "reason"
        ]
      }
    }
  },
  "required": [
    "operation_id",
    "host_id",
    "host_capacity"
  ]
}
