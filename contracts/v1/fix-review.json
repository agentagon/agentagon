{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentagon independent host review",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "candidate_id", "source_digest", "evaluation_digest", "inputs_digest", "trial_ids", "reviewer", "verdict", "rationale", "evidence", "assessments"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "run_id": {"$ref": "#/$defs/text"},
    "candidate_id": {"$ref": "#/$defs/text"},
    "source_digest": {"$ref": "#/$defs/text"},
    "evaluation_digest": {"$ref": "#/$defs/text"},
    "inputs_digest": {"$ref": "#/$defs/text"},
    "trial_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "reviewer": {"$ref": "#/$defs/text"},
    "verdict": {"enum": ["pass", "reject"]},
    "rationale": {"$ref": "#/$defs/text"},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "evaluator_integrity", "issue_relevance", "measurements"],
      "properties": {
        "patch": {"type": "boolean"},
        "evaluator_integrity": {"type": "boolean"},
        "issue_relevance": {"type": "boolean"},
        "measurements": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "allOf": [{"pattern": "\\S"}, {"not": {"pattern": "\u0000"}}]}
  }
}
