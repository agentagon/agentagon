{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "spec": {
      "$ref": "#/$defs/spec"
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "holdout",
            "limited"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "holdout_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "rationale",
        "holdout_paths"
      ]
    },
    "negative_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "mutations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "source",
                "path"
              ]
            }
          },
          "expected_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "description",
          "mutations",
          "expected_checks"
        ]
      }
    },
    "deliver_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metric_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "mutations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "source",
                "path"
              ]
            }
          }
        },
        "required": [
          "id",
          "description",
          "mutations"
        ]
      }
    },
    "metric_comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric": {
            "$ref": "#/$defs/name"
          },
          "better": {
            "$ref": "#/$defs/name"
          },
          "worse": {
            "$ref": "#/$defs/name"
          },
          "min_delta": {
            "type": "number",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "metric",
          "better",
          "worse"
        ]
      }
    }
  },
  "required": [
    "spec",
    "provenance",
    "coverage",
    "negative_cases"
  ],
  "$defs": {
    "text": {
      "$ref": "fix-spec.json#/$defs/text"
    },
    "name": {
      "$ref": "fix-spec.json#/$defs/name"
    },
    "path": {
      "$ref": "fix-spec.json#/$defs/path"
    },
    "executionFile": {
      "$ref": "fix-spec.json#/$defs/executionFile"
    },
    "argv": {
      "$ref": "fix-spec.json#/$defs/argv"
    },
    "command": {
      "$ref": "fix-spec.json#/$defs/command"
    },
    "spec": {
      "$ref": "fix-spec.json"
    }
  },
  "dependentRequired": {
    "metric_cases": [
      "metric_comparisons"
    ],
    "metric_comparisons": [
      "metric_cases"
    ]
  }
}
